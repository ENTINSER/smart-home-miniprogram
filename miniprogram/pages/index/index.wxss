.page {
  padding: 24rpx;
}

.alarm-banner {
  background: #e5484d;
  color: #fff;
  font-weight: 700;
  text-align: center;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  animation: blink 1s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

.conn-bar {
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.conn-ok { background: rgba(46, 196, 125, 0.15); color: #2ec47d; }
.conn-bad { background: rgba(229, 72, 77, 0.15); color: #ff8387; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 28rpx 0 16rpx;
}

.device-card {
  margin-bottom: 20rpx;
}

.safety-card {
  border: 2rpx solid rgba(229, 72, 77, 0.35);
}

.card-danger {
  border-color: #e5484d;
  animation: blink 1.2s ease-in-out infinite;
}

.device-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
}

.safety-tag {
  font-size: 20rpx;
  color: #ff8387;
  border: 1rpx solid #e5484d;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.device-summary {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #7fd3a5;
}

.summary-danger {
  color: #ff8387;
  font-weight: 700;
}

.device-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
}
